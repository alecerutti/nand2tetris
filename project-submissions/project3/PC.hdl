/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Mux16(a=outIncr , b=in , sel=load , out=out1 );
    Mux16(a=out1 , b=false , sel=reset , out=out2 );

    Or(a=load , b=reset , out=loadOrReset );
    Or(a=loadOrReset , b=inc , out=loadOrResetOrInc );
   
    // Avoid workaround with this strange syntax
    Register(in=out2 , load=loadOrResetOrInc , out=outTemp, out=out );
    Inc16(in=outTemp , out=outIncr );
    
    //// Explicit workaournd
    // Register(in=out2 , load=loadOrResetOrInc , out=out3 );
    // Inc16(in=out3 , out=outIncr );
    // Or16(a=false , b=out3 , out=out );
}
