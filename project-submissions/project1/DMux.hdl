// by Nisan and Schocken, MIT Press.
// File name: projects/1/DMux.hdl

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Not(in=sel , out=selNot );
    And(a=in , b=selNot , out=a );
    And(a=in , b=sel , out=b );
}