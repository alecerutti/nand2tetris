// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/1/Xor.hdl

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Or(a= a, b=b , out=outOr );
    Nand(a=a , b=b , out=outNand );
    And(a=outOr , b=outNand , out=out );
}