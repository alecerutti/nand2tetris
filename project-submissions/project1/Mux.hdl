// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/1/Mux.hdl

CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=sel , out=selNot );
    And(a=a , b=selNot , out=out1 );
    And(a=b , b=sel , out=out2 );
    Or(a=out1 , b=out2 , out=out );
}